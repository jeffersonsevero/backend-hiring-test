{
  "name": "rioslum/backend-hiring-test",
  "description": "RioSlum Studio Backend Hiring Test",
  "type": "project",
  "require": {
    "php": ">=8.0"
  },
  "autoload": {
    "psr-4": {
      "RioSlum\\HiringTest\\": "src/"
    }
  },
  "scripts": {
    "import": "php import.php"
  },
  "require-dev": {
    "pestphp/pest": "^4.6",
    "symfony/var-dumper": "^8.0",
    "rector/rector": "^2.4",
    "laravel/pint": "^1.29"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
